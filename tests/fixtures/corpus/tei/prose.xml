        <div type="textpart" subtype="book" n="1">
          <head>Liber primus</head>
          <div type="textpart" subtype="chapter" n="1">
            <div type="textpart" subtype="section" n="pr">
              <p>Gallia est omnis <lb/>divisa in partes tres<note>nota bene</note>.</p>
            </div>
            <div type="textpart" subtype="section" n="3a">
              <p n="x">Quarum unam <del>deleta</del>incolunt Belgae.</p>
            </div>
          </div>
          <pb n="2"/>
          <div type="textpart" subtype="chapter" n="2">
            <div type="textpart" subtype="section" n="62b">
              <ab>Apud Helvetios <milestone unit="para"/>longe nobilissimus fuit Orgetorix.</ab>
            </div>
            <div type="textpart" subtype="section" n="1.5 é">
              <p>Is M. Messala consule.</p>
            </div>
          </div>
          <div type="textpart" subtype="chapter" n="3">
            <div type="textpart" subtype="section" n="1">
              <p>Is <reg>Helvetiis</reg> persuasit, <expan>M<ex>arco</ex></expan> <emph>Pisone</emph> <sic>consulibus</sic>.<desc>codex</desc></p>
            </div>
          </div>
        </div>
