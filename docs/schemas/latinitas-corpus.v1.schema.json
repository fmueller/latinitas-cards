{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/CitationPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "parts",
        "display"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationPart": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "title": "CitationPart",
      "type": "object"
    },
    "CorpusHeader": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "usfx/1",
            "text/1",
            "tei/1"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "corpus_id": {
          "$ref": "#/$defs/CorpusId"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition"
        },
        "format": {
          "const": "latinitas-corpus",
          "title": "Format",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageTag",
          "default": "la"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "norm_rules": {
          "const": "latin-fold/1",
          "default": "latin-fold/1",
          "title": "Norm Rules",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "record": {
          "const": "header",
          "default": "header",
          "title": "Record",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "source": {
          "$ref": "#/$defs/CorpusSource"
        },
        "text_canon": {
          "const": 1,
          "default": 1,
          "title": "Text Canon",
          "type": "integer"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "format",
        "corpus_id",
        "adapter",
        "source"
      ],
      "title": "CorpusHeader",
      "type": "object"
    },
    "CorpusHeading": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CorpusHeading",
      "type": "object"
    },
    "CorpusId": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "CorpusMarkup": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "element": {
          "title": "Element",
          "type": "string"
        },
        "span": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Span",
          "type": "array"
        }
      },
      "required": [
        "element",
        "attributes",
        "span"
      ],
      "title": "CorpusMarkup",
      "type": "object"
    },
    "CorpusMetadata": {
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "$ref": "#/$defs/CorpusId"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "record": {
          "const": "corpus",
          "default": "corpus",
          "title": "Record",
          "type": "string"
        },
        "register": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "corpus_id"
      ],
      "title": "CorpusMetadata",
      "type": "object"
    },
    "CorpusNote": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "f",
            "x",
            "fe",
            "note",
            "variant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "CorpusNote",
      "type": "object"
    },
    "CorpusPassage": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "headings": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CorpusHeading"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headings"
        },
        "native_ref": {
          "$ref": "#/$defs/NativeRef"
        },
        "norm": {
          "title": "Norm",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CorpusNote"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "order": {
          "$ref": "#/$defs/PositiveOrder"
        },
        "passage_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "record": {
          "const": "passage",
          "default": "passage",
          "title": "Record",
          "type": "string"
        },
        "source_extra": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CorpusMarkup"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Extra"
        },
        "source_markup": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CorpusMarkup"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Markup"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "translations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CorpusTranslation"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translations"
        },
        "work": {
          "minLength": 1,
          "title": "Work",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "work",
        "native_ref",
        "order",
        "citation",
        "text",
        "norm",
        "passage_hash"
      ],
      "title": "CorpusPassage",
      "type": "object"
    },
    "CorpusRecord": {
      "discriminator": {
        "mapping": {
          "corpus": "#/$defs/CorpusMetadata",
          "header": "#/$defs/CorpusHeader",
          "passage": "#/$defs/CorpusPassage",
          "work": "#/$defs/CorpusWork"
        },
        "propertyName": "record"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CorpusHeader"
        },
        {
          "$ref": "#/$defs/CorpusMetadata"
        },
        {
          "$ref": "#/$defs/CorpusWork"
        },
        {
          "$ref": "#/$defs/CorpusPassage"
        }
      ]
    },
    "CorpusSource": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "file_name": {
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "file_name",
        "sha256",
        "bytes"
      ],
      "title": "CorpusSource",
      "type": "object"
    },
    "CorpusTranslation": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "provenance": {
          "title": "Provenance",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "language",
        "text",
        "provenance"
      ],
      "title": "CorpusTranslation",
      "type": "object"
    },
    "CorpusWork": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "edition_urn": {
          "anyOf": [
            {
              "pattern": "^urn:cts:[A-Za-z0-9_-]+:[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition Urn"
        },
        "order": {
          "$ref": "#/$defs/PositiveOrder"
        },
        "record": {
          "const": "work",
          "default": "work",
          "title": "Record",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "work": {
          "minLength": 1,
          "title": "Work",
          "type": "string"
        }
      },
      "required": [
        "work",
        "order"
      ],
      "title": "CorpusWork",
      "type": "object"
    },
    "LanguageTag": {
      "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?|[xX](?:-[A-Za-z0-9]{1,8})+|[eE][nN]-[gG][bB]-[oO][eE][dD]|[iI]-[aA][mM][iI]|[iI]-[bB][nN][nN]|[iI]-[dD][eE][fF][aA][uU][lL][tT]|[iI]-[eE][nN][oO][cC][hH][iI][aA][nN]|[iI]-[hH][aA][kK]|[iI]-[kK][lL][iI][nN][gG][oO][nN]|[iI]-[lL][uU][xX]|[iI]-[mM][iI][nN][gG][oO]|[iI]-[nN][aA][vV][aA][jJ][oO]|[iI]-[pP][wW][nN]|[iI]-[tT][aA][oO]|[iI]-[tT][aA][yY]|[iI]-[tT][sS][uU]|[sS][gG][nN]-[bB][eE]-[fF][rR]|[sS][gG][nN]-[bB][eE]-[nN][lL]|[sS][gG][nN]-[cC][hH]-[dD][eE]|[aA][rR][tT]-[lL][oO][jJ][bB][aA][nN]|[cC][eE][lL]-[gG][aA][uU][lL][iI][sS][hH]|[nN][oO]-[bB][oO][kK]|[nN][oO]-[nN][yY][nN]|[zZ][hH]-[gG][uU][oO][yY][uU]|[zZ][hH]-[hH][aA][kK][kK][aA]|[zZ][hH]-[mM][iI][nN]|[zZ][hH]-[mM][iI][nN]-[nN][aA][nN]|[zZ][hH]-[xX][iI][aA][nN][gG])$",
      "type": "string"
    },
    "NativeRef": {
      "pattern": "^(?:[A-Za-z0-9._-]|%[0-9A-F]{2})+$",
      "type": "string"
    },
    "PositiveOrder": {
      "minimum": 1,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$ref": "#/$defs/CorpusRecord",
  "description": "Schema root for a single record in the v1 JSONL stream.",
  "title": "CorpusRecordSchema"
}
